Section: utils
Priority: optional
Depends: libasound2t64 (>= 1.0.17) | libasound2 (>= 1.0.17), libatk-bridge2.0-0t64 (>= 2.5.3) | libatk-bridge2.0-0 (>= 2.5.3), libatk1.0-0t64 (>= 2.32.0) | libatk1.0-0 (>= 2.32.0), libatspi2.0-0t64 (>= 2.9.90) | libatspi2.0-0 (>= 2.9.90), libc6 (>= 2.25), libcairo2 (>= 1.14.0), libcups2t64 (>= 1.7.0) | libcups2 (>= 1.7.0), libdbus-1-3 (>= 1.10), libexpat1 (>= 2.1~beta3), libgbm1 (>= 21.1.0), libgcc-s1 (>= 4.2), libglib2.0-0t64 (>= 2.40.0) | libglib2.0-0 (>= 2.40.0), libgtk-3-0t64 (>= 3.9.10) | libgtk-3-0 (>= 3.9.10), libnspr4 (>= 2:4.9-2~), libnss3 (>= 2:3.30), libpango-1.0-0 (>= 1.14.0), libstdc++6 (>= 5), libudev1 (>= 183), libx11-6 (>= 2:1.4.99.1), libxcb1 (>= 1.9.2), libxcomposite1, libxdamage1 (>= 1:1.1), libxext6, libxfixes3, libxkbcommon0 (>= 0.5.0), libxrandr2
