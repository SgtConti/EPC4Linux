# Dev/test environment for the Evnia Linux port: extracts the vendor installer (7zip, scripts/extract-installer.mjs),
# builds the app, runs Electron headless (Xvfb), runs unit/integration tests and builds + test-installs the .deb.
FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git python3 build-essential pkg-config 7zip \
      xvfb xauth dbus dbus-x11 \
      libgtk-3-0t64 libnss3 libasound2t64 libgbm1 libxkbcommon0 libatk-bridge2.0-0t64 libcups2t64 \
      libdrm2 libxdamage1 libxss1 libnotify4 libxtst6 libsecret-1-0 libpipewire-0.3-0t64 \
      libusb-1.0-0 libudev1 udev i2c-tools \
      dpkg-dev fakeroot file desktop-file-utils lintian \
      fonts-noto-core fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/*
ARG NODE_VERSION=22
RUN V=$(curl -fsSL https://nodejs.org/dist/latest-v${NODE_VERSION}.x/SHASUMS256.txt | grep -oE 'node-v[0-9.]+-linux-x64\.tar\.xz' | head -1) \
 && curl -fsSL https://nodejs.org/dist/latest-v${NODE_VERSION}.x/$V | tar -xJ -C /usr/local --strip-components=1 \
 && node --version && npm --version
WORKDIR /work
